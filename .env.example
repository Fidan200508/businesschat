# Corporate Loan Risk API - Environment Config
# Copy this file to .env and fill in all values.

# JWT signing secret - use a long, random string.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-secret-key-here

# JWT algorithm. Leave as HS256 unless you need RS256.
ALGORITHM=HS256

# Token expiry in minutes.
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Fernet symmetric encryption key for sensitive data at rest.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=your-fernet-key-here

# Production frontend URL for CORS. Leave empty for local dev.
# Example: https://loan-business-frontend.onrender.com
FRONTEND_ORIGIN=
